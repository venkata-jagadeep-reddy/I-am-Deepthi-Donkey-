# PickNLoad React Frontend - Environment Configuration

# Backend API Base URL (leave empty or set to your server address, e.g. http://localhost:8000/api)
VITE_API_BASE_URL=http://localhost:8000/api

# Set to true to use built-in rich mock data and state simulation without running a backend
VITE_USE_MOCK_API=true

# Optional Map API Key (Google Maps / Mapbox / MapmyIndia)
VITE_MAPS_API_KEY=

# App details
VITE_APP_NAME="PickNLoad Logistics"
VITE_APP_VERSION="2.4.0"
